            "index": 0
          }
        ]
      ]
    },
    "Google Places Text Search": {
      "main": [
        [
          {
            "node": "Normalize Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Leads": {
      "main": [
        [
          {
            "node": "Send Results to Render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "content-engine-v2",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}